`timescale 1ns/1ps

module tb_uart_rx;

    reg clk;
    reg rst_n;

    reg baud_tick_16x;
    reg rx_pin;

    reg cfg_parity_en;
    reg cfg_parity_odd;
    reg cfg_stop_2bit;

    wire        rx_fifo_wr;
    wire [7:0]  rx_fifo_din;
    wire        rx_ready;
    wire        rx_error_parity;
    wire        rx_error_framing;

    uart_rx dut (
        .clk(clk),
        .rst_n(rst_n),
        .baud_tick_16x(baud_tick_16x),
        .rx_pin(rx_pin),
        .cfg_parity_en(cfg_parity_en),
        .cfg_parity_odd(cfg_parity_odd),
        .cfg_stop_2bit(cfg_stop_2bit),
        .rx_fifo_wr(rx_fifo_wr),
        .rx_fifo_din(rx_fifo_din),
        .rx_ready(rx_ready),
        .rx_error_parity(rx_error_parity),
        .rx_error_framing(rx_error_framing)
    );

    // Clock
    always #5 clk = ~clk;

    // 16x baud pulse (ONE-CYCLE PULSE)
    integer div16;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            div16 <= 0;
            baud_tick_16x <= 0;
        end else begin
            if (div16 == 0) begin
                baud_tick_16x <= 1'b1;
                div16 <= 15;
            end else begin
                baud_tick_16x <= 1'b0;
                div16 <= div16 - 1;
            end
        end
    end

    // Dump
    initial begin
        $dumpfile("uart_rx.vcd");
        $dumpvars(0, tb_uart_rx);
    end

    // Send UART byte (TIMING-CORRECT)
    task send_uart_byte;
        input [7:0] data;
        input parity_err;
        input frame_err;
        integer i;
        reg parity;
        begin
            rx_pin = 1'b1;
            repeat (32) @(posedge baud_tick_16x);

            rx_pin = 1'b0;
            repeat (16) @(posedge baud_tick_16x);

            parity = 0;
            for (i = 0; i < 8; i = i + 1) begin
                rx_pin = data[i];
                parity = parity ^ data[i];
                repeat (16) @(posedge baud_tick_16x);
            end

            if (cfg_parity_en) begin
                rx_pin = cfg_parity_odd ?
                         (parity_err ? parity : ~parity) :
                         (parity_err ? ~parity : parity);
                repeat (16) @(posedge baud_tick_16x);
            end

            rx_pin = frame_err ? 1'b0 : 1'b1;
            repeat (16) @(posedge baud_tick_16x);
        end
    endtask

    initial begin
        clk = 0;
        rst_n = 0;
        rx_pin = 1;

        cfg_parity_en  = 1;
        cfg_parity_odd = 0;
        cfg_stop_2bit  = 0;

        #50 rst_n = 1;

        // Normal RX
        send_uart_byte(8'hA5, 0, 0);
        @(posedge rx_fifo_wr);
        if (rx_fifo_din !== 8'hA5) $fatal("RX DATA FAIL");

        // Parity error
        send_uart_byte(8'h3C, 1, 0);
        @(posedge rx_fifo_wr);
        if (!rx_error_parity) $fatal("PARITY ERROR NOT DETECTED");

        // Framing error
        send_uart_byte(8'h55, 0, 1);
        @(posedge rx_fifo_wr);
        if (!rx_error_framing) $fatal("FRAMING ERROR NOT DETECTED");

        $display("=================================");
        $display("PASS: RX RTL + TB VERIFIED CLEAN");
        $display("=================================");
        $finish;
    end

endmodule
