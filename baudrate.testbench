`timescale 1ns/1ps

module tb_baud_gen;

    // Clock parameters
    localparam CLK_PERIOD = 20; // 50 MHz

    logic clk;
    logic rst_n;

    logic [15:0] baud_div;
    logic baud_tick;
    logic baud_tick_16x;

    // Instantiate DUT
    baud_gen dut (
        .clk(clk),
        .rst_n(rst_n),
        .baud_div(baud_div),
        .baud_tick(baud_tick),
        .baud_tick_16x(baud_tick_16x)
    );

    // Clock generation
    always #(CLK_PERIOD/2) clk = ~clk;

    // Counters for checking
    integer clk_count_1x;
    integer tick_16x_count;

    // Initial block
    initial begin
        // Waveform dump (EDA Playground requirement)
        $dumpfile("baud_gen.vcd");
        $dumpvars(0, tb_baud_gen);

        // Init
        clk = 0;
        rst_n = 0;
        baud_div = 16'd50;

        clk_count_1x   = 0;
        tick_16x_count = 0;

        // Hold reset
        repeat (5) @(posedge clk);
        rst_n = 1;

        // Run simulation
        repeat (500) @(posedge clk);

        $display("=================================");
        $display("PASS: Baud Generator verified");
        $display("=================================");
        $finish;
    end

    // Check baud_tick spacing
    always @(posedge clk) begin
        if (!rst_n) begin
            clk_count_1x <= 0;
        end else begin
            clk_count_1x <= clk_count_1x + 1;

            if (baud_tick) begin
                if (clk_count_1x != baud_div) begin
                    $error("baud_tick spacing error: expected %0d, got %0d",
                           baud_div, clk_count_1x);
                    $fatal;
                end
                clk_count_1x <= 0;
            end
        end
    end

    // Check 16x oversampling relationship
    always @(posedge clk) begin
        if (!rst_n) begin
            tick_16x_count <= 0;
        end else begin
            if (baud_tick_16x)
                tick_16x_count <= tick_16x_count + 1;

            if (baud_tick) begin
                if (tick_16x_count != 16) begin
                    $error("16x tick error: expected 16, got %0d",
                           tick_16x_count);
                    $fatal;
                end
                tick_16x_count <= 0;
            end
        end
    end

endmodule
