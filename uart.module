`timescale 1ns/1ps

module uart_regs (
    input            clk,
    input            rst_n,

    // Bus interface
    input      [5:0] addr,
    input            wr_en,
    input            rd_en,
    input      [7:0] wdata,
    output reg [7:0] rdata,

    // TX FIFO
    output reg        tx_fifo_wr,
    output reg [7:0]  tx_fifo_din,
    input             tx_fifo_full,
    input             tx_fifo_empty,

    // RX FIFO
    output reg        rx_fifo_rd,
    input      [7:0]  rx_fifo_dout,
    input             rx_fifo_full,
    input             rx_fifo_empty,

    // TX/RX status
    input             tx_busy,
    input             rx_error_parity,
    input             rx_error_framing,

    // Configuration outputs
    output reg        cfg_uart_en,
    output reg        cfg_parity_en,
    output reg        cfg_parity_odd,
    output reg        cfg_stop_2bit,

    output reg [15:0] baud_div,

    // Interrupts
    output reg [4:0]  int_enable,
    input      [4:0]  int_events,     // from IRQ block
    output reg [4:0]  int_status
);

    // Address decode
    localparam ADDR_DATA       = 6'h00;
    localparam ADDR_STATUS     = 6'h04;
    localparam ADDR_CONTROL    = 6'h08;
    localparam ADDR_BAUD_DIV   = 6'h0C;
    localparam ADDR_INT_EN     = 6'h10;
    localparam ADDR_INT_STATUS = 6'h14;

    // -----------------------------
    // WRITE LOGIC
    // -----------------------------
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            tx_fifo_wr    <= 1'b0;
            rx_fifo_rd    <= 1'b0;

            cfg_uart_en   <= 1'b0;
            cfg_parity_en <= 1'b0;
            cfg_parity_odd<= 1'b0;
            cfg_stop_2bit <= 1'b0;

            baud_div      <= 16'd434; // default 115200 @ 50MHz
            int_enable    <= 5'b0;
            int_status    <= 5'b0;
        end else begin
            tx_fifo_wr <= 1'b0;
            rx_fifo_rd <= 1'b0;

            // Latch interrupt events (sticky)
            int_status <= int_status | int_events;

            if (wr_en) begin
                case (addr)

                    ADDR_DATA: begin
                        if (!tx_fifo_full) begin
                            tx_fifo_din <= wdata;
                            tx_fifo_wr  <= 1'b1;
                        end
                    end

                    ADDR_CONTROL: begin
                        cfg_uart_en    <= wdata[0];
                        cfg_parity_en  <= wdata[1];
                        cfg_parity_odd <= wdata[2];
                        cfg_stop_2bit  <= wdata[3];
                    end

                    ADDR_BAUD_DIV: begin
                        baud_div <= {8'd0, wdata};
                    end

                    ADDR_INT_EN: begin
                        int_enable <= wdata[4:0];
                    end

                    ADDR_INT_STATUS: begin
                        int_status <= int_status & ~wdata[4:0]; // W1C
                    end

                endcase
            end

            if (rd_en && addr == ADDR_DATA) begin
                if (!rx_fifo_empty)
                    rx_fifo_rd <= 1'b1;
            end
        end
    end

    // -----------------------------
    // READ LOGIC
    // -----------------------------
    always @(*) begin
        rdata = 8'd0;
        if (rd_en) begin
            case (addr)

                ADDR_DATA:
                    rdata = rx_fifo_dout;

                ADDR_STATUS: begin
                    rdata[0] = tx_fifo_empty;
                    rdata[1] = tx_fifo_full;
                    rdata[2] = rx_fifo_empty;
                    rdata[3] = rx_fifo_full;
                    rdata[4] = tx_busy;
                    rdata[5] = rx_error_parity;
                    rdata[6] = rx_error_framing;
                end

                ADDR_CONTROL:
                    rdata = {4'd0, cfg_stop_2bit, cfg_parity_odd,
                             cfg_parity_en, cfg_uart_en};

                ADDR_BAUD_DIV:
                    rdata = baud_div[7:0];

                ADDR_INT_EN:
                    rdata = {3'd0, int_enable};

                ADDR_INT_STATUS:
                    rdata = {3'd0, int_status};

            endcase
        end
    end

endmodule
