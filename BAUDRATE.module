`timescale 1ns/1ps

module baud_gen #(parameter DIV_WIDTH = 16)(
    input  logic clk,
    input  logic rst_n,

    // Configuration
    input  logic [DIV_WIDTH-1:0] baud_div,   // divisor for 1x baud tick

    // Outputs
    output logic baud_tick,      // 1x baud tick (TX)
    output logic baud_tick_16x    // 16x baud tick (RX)
);

    logic [DIV_WIDTH-1:0] cnt_1x;
    logic [DIV_WIDTH-1:0] cnt_16x;

    logic [DIV_WIDTH-1:0] div_16x;

    // Protect against divide-by-zero
    always_comb begin
        if (baud_div < 16)
            div_16x = 1;
        else
            div_16x = baud_div >> 4; // baud_div / 16
    end

    // 1x baud counter
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            cnt_1x    <= '0;
            baud_tick <= 1'b0;
        end else begin
            if (cnt_1x == baud_div - 1) begin
                cnt_1x    <= '0;
                baud_tick <= 1'b1;
            end else begin
                cnt_1x    <= cnt_1x + 1'b1;
                baud_tick <= 1'b0;
            end
        end
    end

    // 16x oversampling counter
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            cnt_16x        <= '0;
            baud_tick_16x  <= 1'b0;
        end else begin
            if (cnt_16x == div_16x - 1) begin
                cnt_16x        <= '0;
                baud_tick_16x  <= 1'b1;
            end else begin
                cnt_16x        <= cnt_16x + 1'b1;
                baud_tick_16x  <= 1'b0;
            end
        end
    end

endmodule
