`timescale 1ns/1ps

module fifo #(
    parameter DATA_WIDTH = 8,
    parameter DEPTH      = 16,
    parameter AFULL_TH   = DEPTH-2   // almost-full threshold
)(
    input  logic                  clk,
    input  logic                  rst_n,

    // Write interface
    input  logic                  wr_en,
    input  logic [DATA_WIDTH-1:0] wdata,

    // Read interface
    input  logic                  rd_en,
    output logic [DATA_WIDTH-1:0] rdata,

    // Status
    output logic                  full,
    output logic                  empty,
    output logic                  almost_full,
    output logic [$clog2(DEPTH):0] count
);

    // Internal storage
    logic [DATA_WIDTH-1:0] mem [0:DEPTH-1];

    logic [$clog2(DEPTH)-1:0] wr_ptr;
    logic [$clog2(DEPTH)-1:0] rd_ptr;

    // Write operation
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            wr_ptr <= '0;
        end else begin
            if (wr_en && !full) begin
                mem[wr_ptr] <= wdata;
                wr_ptr <= (wr_ptr == DEPTH-1) ? '0 : wr_ptr + 1'b1;
            end
        end
    end

    // Read operation
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            rd_ptr <= '0;
            rdata  <= '0;
        end else begin
            if (rd_en && !empty) begin
                rdata <= mem[rd_ptr];
                rd_ptr <= (rd_ptr == DEPTH-1) ? '0 : rd_ptr + 1'b1;
            end
        end
    end

    // Count logic
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            count <= '0;
        end else begin
            case ({wr_en && !full, rd_en && !empty})
                2'b10: count <= count + 1'b1; // write only
                2'b01: count <= count - 1'b1; // read only
                default: count <= count;      // no change or simultaneous
            endcase
        end
    end

    // Status flags
    always_comb begin
        empty       = (count == 0);
        full        = (count == DEPTH);
        almost_full = (count >= AFULL_TH);
    end

endmodule
