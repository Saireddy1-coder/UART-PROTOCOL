module tb_uart();
    // Inputs to the DUT (driven in initial blocks)
    logic clk = 0;
    logic rst_n = 0;
    logic [5:0] addr = 0;
    logic wr_en = 0;
    logic rd_en = 0;
    logic [7:0] wdata = 0;

    // This signal connects tx to rx, so it must be a wire
    wire rx_pin; 

    // Outputs from the DUT (driven by the module)
    wire [7:0] rdata;
    wire tx_pin;
    wire irq;

    // This is the continuous assignment causing your error.
    // It works now because rx_pin is a 'wire'.
    assign rx_pin = tx_pin; 

    // Instantiate Top
    uart_top uut (
        .clk(clk),
        .rst_n(rst_n),
        .addr(addr),
        .wr_en(wr_en),
        .rd_en(rd_en),
        .wdata(wdata),
        .rdata(rdata),
        .rx_pin(rx_pin),
        .tx_pin(tx_pin),
        .irq(irq)
    );

    // ... (rest of your initial block remains the same)

    initial begin
        $dumpfile("dump.vcd"); $dumpvars(0, tb_uart);
        
        // Reset
        #20 rst_n = 1;
        
        // Write data to TX FIFO
        @(posedge clk);
        wdata = 8'hAB; wr_en = 1; addr = 0;
        @(posedge clk);
        wr_en = 0;

        // Wait for IRQ (Data received in RX FIFO)
        wait(irq);
        #100;
        
        // Read from RX FIFO
        rd_en = 1; addr = 0;
        @(posedge clk);
        $display("SUCCESS: Received Data = %h", rdata);
        rd_en = 0;

        #200 $finish;
    end
endmodule
