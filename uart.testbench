`timescale 1ns/1ps

module tb_uart_regs;

    // Clock & reset
    reg clk;
    reg rst_n;

    // Bus
    reg  [5:0] addr;
    reg        wr_en;
    reg        rd_en;
    reg  [7:0] wdata;
    wire [7:0] rdata;

    // TX FIFO
    wire        tx_fifo_wr;
    wire [7:0]  tx_fifo_din;
    reg         tx_fifo_full;
    reg         tx_fifo_empty;

    // RX FIFO
    wire        rx_fifo_rd;
    reg  [7:0]  rx_fifo_dout;
    reg         rx_fifo_full;
    reg         rx_fifo_empty;

    // Status inputs
    reg tx_busy;
    reg rx_error_parity;
    reg rx_error_framing;

    // Config outputs
    wire cfg_uart_en;
    wire cfg_parity_en;
    wire cfg_parity_odd;
    wire cfg_stop_2bit;
    wire [15:0] baud_div;

    // Interrupts
    wire [4:0] int_enable;
    reg  [4:0] int_events;
    wire [4:0] int_status;

    // DUT
    uart_regs dut (
        .clk(clk),
        .rst_n(rst_n),
        .addr(addr),
        .wr_en(wr_en),
        .rd_en(rd_en),
        .wdata(wdata),
        .rdata(rdata),

        .tx_fifo_wr(tx_fifo_wr),
        .tx_fifo_din(tx_fifo_din),
        .tx_fifo_full(tx_fifo_full),
        .tx_fifo_empty(tx_fifo_empty),

        .rx_fifo_rd(rx_fifo_rd),
        .rx_fifo_dout(rx_fifo_dout),
        .rx_fifo_full(rx_fifo_full),
        .rx_fifo_empty(rx_fifo_empty),

        .tx_busy(tx_busy),
        .rx_error_parity(rx_error_parity),
        .rx_error_framing(rx_error_framing),

        .cfg_uart_en(cfg_uart_en),
        .cfg_parity_en(cfg_parity_en),
        .cfg_parity_odd(cfg_parity_odd),
        .cfg_stop_2bit(cfg_stop_2bit),
        .baud_div(baud_div),

        .int_enable(int_enable),
        .int_events(int_events),
        .int_status(int_status)
    );

    // Clock
    always #5 clk = ~clk;

    // Dump
    initial begin
        $dumpfile("uart_regs.vcd");
        $dumpvars(0, tb_uart_regs);
    end

    // Bus helpers
    task write_reg(input [5:0] a, input [7:0] d);
        begin
            @(posedge clk);
            addr  = a;
            wdata = d;
            wr_en = 1;
            rd_en = 0;
            @(posedge clk);
            wr_en = 0;
        end
    endtask

    task read_reg(input [5:0] a);
        begin
            @(posedge clk);
            addr  = a;
            rd_en = 1;
            wr_en = 0;
            @(posedge clk);
            rd_en = 0;
        end
    endtask

    // Test sequence
    initial begin
        // Init
        clk = 0;
        rst_n = 0;
        addr = 0;
        wr_en = 0;
        rd_en = 0;
        wdata = 0;

        tx_fifo_full  = 0;
        tx_fifo_empty = 1;
        rx_fifo_empty = 0;
        rx_fifo_full  = 0;
        rx_fifo_dout  = 8'hAB;

        tx_busy = 0;
        rx_error_parity = 0;
        rx_error_framing = 0;

        int_events = 0;

        // Reset
        #20 rst_n = 1;

        // -------------------------
        // TEST 1: CONTROL register
        // -------------------------
        write_reg(6'h08, 8'b0000_1111);
        if (!cfg_uart_en || !cfg_parity_en || !cfg_parity_odd || !cfg_stop_2bit)
            $fatal("CONTROL register failed");

        // -------------------------
        // TEST 2: BAUD_DIV
        // -------------------------
        write_reg(6'h0C, 8'h55);
        if (baud_div[7:0] != 8'h55)
            $fatal("BAUD_DIV write failed");

        // -------------------------
        // TEST 3: DATA write → TX FIFO
        // -------------------------
        write_reg(6'h00, 8'hA5);
        if (!tx_fifo_wr || tx_fifo_din != 8'hA5)
            $fatal("TX FIFO write failed");

        // -------------------------
        // TEST 4: DATA read → RX FIFO
        // -------------------------
        read_reg(6'h00);
        if (!rx_fifo_rd || rdata != 8'hAB)
            $fatal("RX FIFO read failed");

        // -------------------------
        // TEST 5: STATUS register
        // -------------------------
        tx_busy = 1;
        rx_error_parity = 1;
        read_reg(6'h04);
        if (rdata[4] != 1 || rdata[5] != 1)
            $fatal("STATUS register incorrect");

        // -------------------------
        // TEST 6: INT_STATUS sticky
        // -------------------------
        int_events = 5'b00101;
        @(posedge clk);
        if (int_status != 5'b00101)
            $fatal("INT_STATUS not sticky");

        // -------------------------
        // TEST 7: INT_STATUS W1C
        // -------------------------
        write_reg(6'h14, 8'b0000_0101);
        if (int_status != 0)
            $fatal("INT_STATUS W1C failed");

        $display("=================================");
        $display("PASS: UART REGS VERIFIED CLEANLY");
        $display("=================================");
        $finish;
    end

endmodule
